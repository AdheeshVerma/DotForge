{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "source": "arch",
        "padding": {
            "top": 3,
            "left": 2,
            "right": 4
        }
    },

    "display": {
        "separator": "  ",
        "color": "white",
        "key": {
            "width": 12
        }
    },

    "modules": [
        "break",

        {
            "type": "title",
            "format": "{user-name}@arch"
        },

        "break",

        {
            "type": "kernel",
            "key": "󰌽 kernel"
        },

        {
            "type": "uptime",
            "key": "󰅐 uptime"
        },

        {
            "type": "shell",
            "key": " shell"
        },

        {
            "type": "wm",
            "key": " wm"
        },

        {
            "type": "terminal",
            "key": " term"
        },

        {
            "type": "cpu",
            "key": "󰻠 cpu"
        },

        {
            "type": "gpu",
            "key": "󰢮 gpu"
        },

        {
            "type": "memory",
            "key": "󰍛 mem"
        },

        {
            "type": "packages",
            "key": "󰏖 pkgs"
        },

        {
            "type": "custom",
            "key": "󰣇 distro",
            "format": "Arch Linux"
        },

        "break"
    ]
}
